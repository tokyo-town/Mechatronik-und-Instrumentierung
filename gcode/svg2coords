import xml.etree.ElementTree as ET
import re
import numpy as np

# -----------------------------
# CONFIG
# -----------------------------
SAMPLES_PER_CURVE = 20  # mehr = glatter, aber mehr Punkte

# -----------------------------
# PATH PARSER HELPERS
# -----------------------------

def parse_path_d(d):
    # sehr vereinfachter Parser für M/L/C (reicht für viele SVGs)
    tokens = re.findall(r"[MLCZmlcz]|-?\d*\.?\d+", d)

    commands = []
    i = 0

    while i < len(tokens):
        if re.match(r"[MLCZmlcz]", tokens[i]):
            cmd = tokens[i]
            i += 1
        else:
            cmd = None

        if cmd in ["M", "L"]:
            x = float(tokens[i]); y = float(tokens[i+1])
            commands.append((cmd, x, y))
            i += 2

        elif cmd in ["C"]:
            # cubic bezier: 3 points
            pts = [float(tokens[i+j]) for j in range(6)]
            commands.append((cmd, pts))
            i += 6

        elif cmd in ["Z", "z"]:
            commands.append(("Z",))
        else:
            i += 1

    return commands


def lerp(a, b, t):
    return a + (b - a) * t


def sample_line(p0, p1, n):
    return [(lerp(p0[0], p1[0], t),
             lerp(p0[1], p1[1], t)) for t in np.linspace(0, 1, n)]


def sample_cubic(p0, p1, p2, p3, n):
    pts = []
    for t in np.linspace(0, 1, n):
        x = (
            (1-t)**3 * p0[0] +
            3*(1-t)**2*t * p1[0] +
            3*(1-t)*t**2 * p2[0] +
            t**3 * p3[0]
        )
        y = (
            (1-t)**3 * p0[1] +
            3*(1-t)**2*t * p1[1] +
            3*(1-t)*t**2 * p2[1] +
            t**3 * p3[1]
        )
        pts.append((x, y))
    return pts


# -----------------------------
# MAIN FUNCTION
# -----------------------------

def extract_svg_points(svg_file):
    tree = ET.parse(svg_file)
    root = tree.getroot()

    points = []
    pen_lift_indices = []

    current_pos = None

    for elem in root.iter():
        if "path" in elem.tag:
            d = elem.attrib.get("d")
            if not d:
                continue

            cmds = parse_path_d(d)

            start_new_path = True

            for cmd in cmds:

                # MOVE
                if cmd[0] == "M":
                    current_pos = (cmd[1], cmd[2])
                    points.append(current_pos)

                    if not start_new_path:
                        pen_lift_indices.append(len(points)-1)

                    start_new_path = False

                # LINE
                elif cmd[0] == "L":
                    new_pos = (cmd[1], cmd[2])
                    seg = sample_line(current_pos, new_pos, SAMPLES_PER_CURVE)

                    points.extend(seg)
                    current_pos = new_pos

                # CURVE
                elif cmd[0] == "C":
                    p0 = current_pos
                    p1, p2, p3 = [(cmd[1][i], cmd[1][i+1]) for i in range(0, 6, 2)]

                    seg = sample_cubic(p0, p1, p2, p3, SAMPLES_PER_CURVE)
                    points.extend(seg)

                    current_pos = p3

                # CLOSE PATH
                elif cmd[0] in ["Z", "z"]:
                    pass

    return points, pen_lift_indices


# -----------------------------
# RUN
# -----------------------------
if __name__ == "__main__":
    svg_file = "input.svg"

    points, pen_lifts = extract_svg_points(svg_file)

    print("TOTAL POINTS:", len(points))
    print("PEN LIFT INDICES:", pen_lifts)

    # optional export
    with open("points.csv", "w") as f:
        for p in points:
            f.write(f"{p[0]},{p[1]}\n")

    with open("pen_lifts.txt", "w") as f:
        f.write(",".join(map(str, pen_lifts)))